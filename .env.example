# Base URL used for SEO metadata, sitemap, canonical links, and QR codes.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://kelas-bermain.vercel.app

# Shared database (Supabase). REQUIRED — without these, registration,
# payment, attendance and the affiliate programme cannot work at all: there
# is no other place for a submission from one visitor's browser to become
# visible to anyone else, including the team.
#
# The anon key is safe to ship in the browser bundle by design — every table
# has Row Level Security enabled with zero policies (default deny), so this
# key can only call the specific functions defined in supabase/schema.sql.
# Run that file once in the Supabase SQL Editor before setting these.
# There is no service-role key anywhere in this app; the team reviews and
# approves data (affiliate applications, payment proofs) directly in the
# Supabase Table Editor, logged in with their own Supabase account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive folder linked from the public gallery page.
# Optional — falls back to the value in src/data/gallery.ts.
NEXT_PUBLIC_GALLERY_DRIVE_URL=

# Show the organisation's WhatsApp number in the public contact box.
# The director's meeting notes asked for no phone number on the site; the team
# later asked for it back (PRD v2.0, KONF-01). Off until that is settled.
NEXT_PUBLIC_SHOW_WHATSAPP=false

# Certificate lookup and issuing. Kelas Bermain does not issue e-certificates
# (PRD v2.0, R-06 / K-07), so this stays off. The code remains in the tree.
FEATURE_CERTIFICATES=false
