# Base URL used for SEO metadata, sitemap, canonical links, and QR codes.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://kelasbermain.id

# Postgres. REQUIRED — without this, nothing in the app works: registration,
# payment, attendance, the affiliate programme and the CMS all read and write
# through Prisma, and there is no other data path.
#
# Run the migrations once against a fresh database:
#   npx prisma migrate deploy
# Locally, `npm run db:start` runs Postgres from node_modules with no
# Homebrew or Docker needed — see scripts/db.mjs for details.
#
# There is no service-role key and no row-level security bypass anywhere in
# this app. Every write goes through a server action or an admin_* database
# function that checks the caller's session first.
DATABASE_URL=

# Where uploaded media (CMS images, Instagram sync) lives on disk.
# Served back out through /uploads/[...path]. Defaults to public/uploads,
# which keeps files visible during development; in production, point this at
# a persistent volume, or let nginx serve the same folder directly.
UPLOAD_DIR=public/uploads

# Where uploaded payment-transfer proofs live on disk. Deliberately OUTSIDE
# UPLOAD_DIR / public: a screenshot of someone's banking app must never sit
# at a guessable, publicly-served URL. Served only to a signed-in admin,
# through /admin/payments/proof/[name].
PAYMENT_PROOF_DIR=storage/bukti-pembayaran

# Google Drive folder linked from the public gallery page.
# Optional — falls back to the value in src/data/gallery.ts.
NEXT_PUBLIC_GALLERY_DRIVE_URL=

# Show the organisation's WhatsApp number in the public contact box.
# The director's meeting notes asked for no phone number on the site; the team
# later asked for it back (PRD v2.0, KONF-01). Off until that is settled.
NEXT_PUBLIC_SHOW_WHATSAPP=false

# Certificate lookup and issuing. Kelas Bermain does not issue e-certificates
# (PRD v2.0, R-06 / K-07), so this stays off. The code remains in the tree.
FEATURE_CERTIFICATES=false

# Nomor WhatsApp tujuan pendaftaran, format internasional tanpa tanda plus.
# Kosongkan untuk memakai nomor WhatsApp Kelas Bermain 6281774918611.
NEXT_PUBLIC_WHATSAPP_REGISTRATION_NUMBER=

# ------------------------------------------------------------------
# Instagram — halaman Update
# ------------------------------------------------------------------
# Jalur utama: Apify, dipanggil tiap tengah malam lewat crontab di server
# (contoh: curl -H "Authorization: Bearer $CRON_SECRET" https://.../api/cron/instagram).
# Apify menjalankan browser di sisi mereka, jadi ini bisa hidup di server —
# Instagram sendiri menolak permintaan langsung dari IP datacenter.
# Token dibuat di https://console.apify.com/account/integrations
APIFY_TOKEN=
# Rahasia pelindung /api/cron/instagram. Tanpa ini rutenya mati (503).
# Buat dengan: openssl rand -hex 32
CRON_SECRET=
# Lewati reel/video kalau hanya mau foto (default false — reel ikut ditarik).
INSTAGRAM_SKIP_VIDEO=false
# Berapa postingan terbaru yang ditarik tiap sinkron (default 12).
INSTAGRAM_LIMIT=12
INSTAGRAM_USERNAME=@kelasbermain.id

# Jalur cadangan gratis kalau kuota Apify habis: npm run instagram:scrape,
# menjalankan Firefox headless dari laptop (lihat scripts/instagram-scrape.mjs).
# Dibaca langsung dari .env.local oleh skrip itu, bukan oleh aplikasi.
# FIREFOX_PATH=/Applications/Firefox.app/Contents/MacOS/firefox

# Jalur lama, dipertahankan untuk kompatibilitas kalau suatu hari kembali
# memakai Instagram API with Instagram Login alih-alih Apify. Tidak dipakai
# cron yang berjalan sekarang.
INSTAGRAM_ACCESS_TOKEN=

# Set false hanya jika menjalankan `npm start` lewat http (mis. localhost). Di VPS https biarkan kosong.
# COOKIE_SECURE=false
